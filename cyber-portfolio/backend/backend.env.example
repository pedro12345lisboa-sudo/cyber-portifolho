# ============================================================
# Backend (.env) - Cyber Portfolio API (FastAPI)
# ============================================================
# Copie este arquivo para ".env" na pasta backend/ e preencha
# com os valores reais. NUNCA commite o .env de verdade no git.

# URL do projeto Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave usada pelo backend para falar com o Supabase.
#
# IMPORTANTE - qual chave usar aqui:
#   Depois de aplicar as policies de RLS (ver rls_policies.sql),
#   o backend passa a se comportar como um usuário "anon" nas
#   consultas -- então a ANON KEY já é suficiente para as leituras
#   públicas (perfil, skills, projetos, avaliacoes) e para o INSERT
#   público em avaliacoes.
#
#   Use a SERVICE ROLE KEY somente se, no futuro, o backend precisar
#   fazer alguma operação que as policies de RLS não permitem para
#   "anon" (ex: um endpoint administrativo separado do /admin do
#   frontend). Se usar a service_role key, trate-a com o mesmo
#   cuidado de uma senha de root do banco -- ela ignora todo o RLS.
#
# Local: Project Settings -> API -> Project API keys
SUPABASE_KEY=coloque_aqui_a_anon_public_key

# Origem exata do frontend em produção, para o CORS.
# Em desenvolvimento local pode deixar http://localhost:5173
# (ou a porta que o Vite estiver usando).
FRONTEND_ORIGIN=https://cyber-portifolho.vercel.app
